# 阿里云百炼（DashScope）
# 获取：https://bailian.console.aliyun.com/ → API-KEY 管理 → 创建
DASHSCOPE_API_KEY=

# 模型（qwen3.8 系列原生支持图像理解）
# qwen3.8-max   ：旗舰，质量最好，单次约 35-45 秒
# qwen3.8-flash ：更快，约 16 秒，质量稍弱
DASHSCOPE_MODEL=qwen3.8-max

# 可选
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# PORT=5173
# RATE_LIMIT=30
